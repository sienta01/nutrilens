# Copy to .env. Keep secrets out of source control.
APP_URL=http://localhost:8000
DATABASE_URL=sqlite:///./data/nutrilens.db
UPLOAD_DIR=./data/uploads
COOKIE_SECURE=false
DEMO_ENABLED=true

# CRITICAL, ERROR, WARNING, INFO, or DEBUG. INFO logs the AI failover chain at
# startup and one line per provider attempt. Keys are never logged.
LOG_LEVEL=INFO
# Logs go to the console and to this rotating file. Empty disables the file.
# Run one worker per log file: rotation assumes a single writer.
LOG_FILE=data/nutrilens.log
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=3

# Create a bot with @BotFather in Telegram. Username excludes @.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Enable after adding your token. Run exactly one app worker with polling.
TELEGRAM_POLLING=false

# --- Meal analysis: ordered failover chain (preferred) ---------------------
# Each line is tried in order, and only when the previous one FAILS (quota, auth,
# outage, unreadable reply). A provider answering "that isn't food" is a real
# answer and stops the chain, so a refusal never costs a second quota.
# Every line uses its own key and billing account. AI_n_MODEL is optional and
# defaults to that provider's model below. Providers: gemini, groq, openai.
# Setting any AI_n_* line REPLACES the single-provider settings further down.
AI_1_PROVIDER=
AI_1_API_KEY=
AI_1_MODEL=

AI_2_PROVIDER=
AI_2_API_KEY=
AI_2_MODEL=

AI_3_PROVIDER=
AI_3_API_KEY=
AI_3_MODEL=

# --- Meal analysis: single provider (used only when no AI_n_* line is set) --
AI_PROVIDER=gemini

# Get a key at https://aistudio.google.com/apikey and use an eligible free-tier project.
# Free-tier content may be used by Google to improve its products; quotas apply.
GEMINI_API_KEY=
# A moving alias; Google retires pinned model IDs over time.
GEMINI_MODEL=gemini-flash-latest

# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# Separately billed API usage.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
